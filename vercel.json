{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"staging\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "functions": {
    "app/api/**": {
      "regions": ["gru1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/whatsapp-reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "*/5 * * * *"
    }
  ]
}
