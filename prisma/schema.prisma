generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ServiceProvider {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  hashedPassword      String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isActive            Boolean              @default(true)
  rol                 ServiceProviderRol   @default(propietario)
  attendsAppointments Boolean              @default(true)
  appointments        Appointment[]
  businessProfile     BusinessProfile?
  empresas            EmpleadoEmpresa[]
  sucursales          EmpleadoSucursal[]
  expenses            Expense[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  scheduleConfigs     ScheduleConfig[]
  listaEspera         ListaEspera[]
  tutorialCompleted   Boolean              @default(false)
  modoTurno           ModoTurno            @default(FIJO)

  @@map("service_providers")
}

model Expense {
  id                String          @id @default(cuid())
  descripcion       String
  monto             Decimal
  serviceProviderId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  @@map("expenses")
}

model BusinessProfile {
  id                String            @id @default(cuid())
  name              String
  logoUrl           String?
  address           String?
  phone             String?
  cbu               String?
  alias             String?
  slug              String            @unique
  serviceProviderId String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  brandColor        String            @default("#1e3a5f")
  brandColorDark    String?
  theme             String            @default("light")
  rubro             String
  cashEnabled       Boolean           @default(true)
  transferEnabled   Boolean           @default(true)
  serviceProvider   ServiceProvider   @relation(fields: [serviceProviderId], references: [id])
  empleados         EmpleadoEmpresa[]
  scheduleConfigs   ScheduleConfig[]
  serviceTypes      ServiceType[]
  sucursales        Sucursal[]

  @@map("business_profiles")
}

model Sucursal {
  id                String             @id @default(cuid())
  name              String
  address           String
  businessProfileId String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  appointments      Appointment[]
  empleados         EmpleadoSucursal[]
  businessProfile   BusinessProfile    @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("sucursales")
}

model ScheduleConfig {
  id                String           @id @default(cuid())
  startTime         String
  endTime           String
  intervalMinutes   Int
  price             Decimal
  businessProfileId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  daysOfWeek        Int[]
  isActive          Boolean          @default(true)
  name              String
  serviceProviderId String?
  minAdvanceHours   Int              @default(0)
  appointments      Appointment[]
  disabledSlots     DisabledSlot[]
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id])
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  serviceTypes      ServiceType[]    @relation("ScheduleConfigToServiceType")

  @@map("schedule_configs")
}

model DisabledSlot {
  id               String         @id @default(cuid())
  scheduleConfigId String
  date             String
  time             String
  createdAt        DateTime       @default(now())
  scheduleConfig   ScheduleConfig @relation(fields: [scheduleConfigId], references: [id], onDelete: Cascade)

  @@map("disabled_slots")
}

model ServiceType {
  id                String           @id @default(cuid())
  title             String
  description       String?
  price             Decimal
  duracion          Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessProfileId String
  appointments      Appointment[]
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id])
  scheduleConfigs   ScheduleConfig[] @relation("ScheduleConfigToServiceType")

  @@map("service_types")
}

model Appointment {
  id                String          @id @default(cuid())
  time              String
  isActive          Boolean         @default(true)
  scheduleConfigId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  date              String
  serviceProviderId String
  serviceTypeId     String?
  sucursalId        String?
  isTutorial        Boolean         @default(false)
  scheduleConfig    ScheduleConfig? @relation(fields: [scheduleConfigId], references: [id])
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  serviceType       ServiceType?    @relation(fields: [serviceTypeId], references: [id])
  sucursal          Sucursal?       @relation(fields: [sucursalId], references: [id])
  booking           Booking?

  @@map("appointments")
}

model Booking {
  id                     String              @id @default(cuid())
  appointmentId          String              @unique
  clientName             String
  clientPhone            String
  status                 BookingStatus       @default(pending)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  previousStatus         BookingStatus?
  clienteId              String?
  whatsappReminderSentAt DateTime?
  preReminderSentAt      DateTime?
  paymentMethod          String?
  appointment            Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  cliente                Cliente?            @relation(fields: [clienteId], references: [id])
  rescheduleRequests     RescheduleRequest[]
  listaEspera            ListaEspera[]

  @@map("bookings")
}

model Cliente {
  id                      String                      @id @default(cuid())
  nombre                  String
  apellido                String
  email                   String                      @unique
  hashedPassword          String
  sexo                    String?
  edad                    Int?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  telefono                String?
  notificacionesActivadas Boolean                     @default(false)
  bookings                Booking[]
  rescheduleRequests      RescheduleRequest[]
  pushSubscriptions       ClientePushSubscription[]
  listaEspera             ListaEspera[]
  passwordResetTokens     ClientePasswordResetToken[]

  @@map("clientes")
}

model RescheduleRequest {
  id            String                  @id @default(cuid())
  bookingId     String
  clienteId     String
  requestedDate String
  requestedTime String
  status        RescheduleRequestStatus @default(pending)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  booking       Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cliente       Cliente                 @relation(fields: [clienteId], references: [id])

  @@map("reschedule_requests")
}

model EmpleadoEmpresa {
  id                String          @id @default(cuid())
  businessProfileId String
  createdAt         DateTime        @default(now())
  serviceProviderId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@map("empleado_empresas")
}

model EmpleadoSucursal {
  id                String          @id @default(cuid())
  sucursalId        String
  createdAt         DateTime        @default(now())
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  sucursal          Sucursal        @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@map("empleado_sucursales")
}

model ClientePushSubscription {
  id        String   @id @default(cuid())
  clienteId String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, endpoint])
  @@map("cliente_push_subscriptions")
}

model PushSubscription {
  id                String          @id @default(cuid())
  endpoint          String          @unique
  p256dh            String
  auth              String
  serviceProviderId String
  createdAt         DateTime        @default(now())
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

enum ModoTurno {
  FIJO
  POR_TIPO
}

enum ServiceProviderRol {
  propietario
  administrador
  empleado
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  requires_reschedule
}

enum RescheduleRequestStatus {
  pending
  approved
  rejected
}

enum EstadoListaEspera {
  activa
  notificada
  expirada
}

model ListaEspera {
  id                   String                      @id @default(cuid())
  clienteId            String
  serviceProviderId    String
  posicion             Int
  estado               EstadoListaEspera           @default(activa)
  bookingIdRespaldo    String?
  cualquierVacante     Boolean                     @default(false)
  notificadaAt         DateTime?
  notificacionToken    String?                     @unique
  notificacionTokenExp DateTime?
  vacanteTurnoId       String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  cliente              Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  serviceProvider      ServiceProvider             @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  bookingRespaldo      Booking?                    @relation(fields: [bookingIdRespaldo], references: [id])
  disponibilidades     DisponibilidadListaEspera[]

  @@unique([clienteId, serviceProviderId])
  @@map("lista_espera")
}

model ClientePasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  clienteId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("cliente_password_reset_tokens")
}

model PasswordResetToken {
  id                String          @id @default(cuid())
  token             String          @unique
  serviceProviderId String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime        @default(now())
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model DisponibilidadListaEspera {
  id            String      @id @default(cuid())
  listaEsperaId String
  diaSemana     Int
  horaInicio    String
  horaFin       String
  listaEspera   ListaEspera @relation(fields: [listaEsperaId], references: [id], onDelete: Cascade)

  @@map("disponibilidad_lista_espera")
}

// ─────────────────────────────────────────────────────────────
// Módulo Notas (app secundaria, sin login). Identidad anónima por
// device + frase de recuperación. Todo cuelga del NotaDevice.
// ─────────────────────────────────────────────────────────────

model NotaDevice {
  id           String   @id @default(cuid())
  // Hash determinístico de la contraseña de recuperación que elige el usuario.
  // Nullable: un device recién creado no tiene contraseña hasta que se define.
  passwordHash String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notas             Nota[]
  pushSubscriptions NotaPushSubscription[]

  @@map("nota_devices")
}

model Nota {
  id        String   @id @default(cuid())
  deviceId  String
  title     String   @default("")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device     NotaDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reminders  NotaReminder[]
  progresses NotaProgress[]

  @@index([deviceId])
  @@map("notas")
}

model NotaReminder {
  id           String   @id @default(cuid())
  notaId       String
  deviceId     String
  text         String   @default("")
  time         String
  daysOfWeek   Int[]
  oneTimeDate  String?
  intervalMinutes Int?
  endTime      String?
  enabled      Boolean  @default(true)
  lastFiredKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nota Nota @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([deviceId, enabled])
  @@index([notaId])
  @@map("nota_reminders")
}

model NotaProgress {
  id        String   @id @default(cuid())
  notaId    String
  hasGoal   Boolean  @default(false)
  goal      Int?
  count     Int      @default(0)
  label     String   @default("")
  color     String   @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nota  Nota               @relation(fields: [notaId], references: [id], onDelete: Cascade)
  notes NotaProgressNote[]

  @@index([notaId])
  @@map("nota_progresses")
}

model NotaProgressNote {
  id         String   @id @default(cuid())
  progressId String
  text       String   @default("")
  dotColor   String   @default("green")
  createdAt  DateTime @default(now())

  progress NotaProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@map("nota_progress_notes")
}

model NotaPushSubscription {
  id        String   @id @default(cuid())
  deviceId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  device NotaDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("nota_push_subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Módulo Lavandería (app secundaria en /lavanderia, sin login).
// Single-tenant. La "sesión" es el empleadoId activo guardado en
// localStorage del navegador y enviado en el header x-empleado-id.
// ─────────────────────────────────────────────────────────────

model LavEmpleado {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  esAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Credenciales: solo los admins las tienen. El login del admin es por
  // email + contraseña (sesion cookie propia), no por el selector del navbar.
  email          String? @unique
  hashedPassword String?

  otsCargadas   LavOT[] @relation("LavOTCarga")
  otsTrabajadas LavOT[] @relation("LavOTTrabajo")
  resetTokens   LavPasswordResetToken[]

  @@map("lav_empleados")
}

model LavPasswordResetToken {
  id         String      @id @default(cuid())
  token      String      @unique
  empleadoId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime    @default(now())
  empleado   LavEmpleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@map("lav_password_reset_tokens")
}

// Proceso granular (lavado, secado, planchado...). Suma minutos que dependen
// de la prenda (matriz Tiempos = prenda x proceso).
model LavProceso {
  id        String   @id @default(cuid())
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  duraciones LavDuracion[]
  servicios  LavServicioProceso[]

  @@map("lav_procesos")
}

// Servicio (LIMPIEZA, etc.): nombre + conjunto fijo de procesos. La duración de
// un item es la suma de los minutos de los procesos de sus servicios.
model LavServicio {
  id        String   @id @default(cuid())
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  procesos LavServicioProceso[]

  @@map("lav_servicios")
}

// Composición global de un servicio: qué procesos lo integran.
model LavServicioProceso {
  id         String @id @default(cuid())
  servicioId String
  procesoId  String

  servicio LavServicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  proceso  LavProceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@unique([servicioId, procesoId])
  @@index([servicioId])
  @@index([procesoId])
  @@map("lav_servicio_procesos")
}

model LavPrenda {
  id         String   @id @default(cuid())
  nombre     String
  orden      Int      @default(0)
  incompleta Boolean  @default(false) // creada desde la carga por foto ("varios"): falta cargarle los minutos
  createdAt  DateTime @default(now())

  duraciones LavDuracion[]
  items      LavOTItem[]

  @@map("lav_prendas")
}

// Tiempos: minutos de un proceso para una prenda (matriz prenda x proceso).
model LavDuracion {
  id        String @id @default(cuid())
  prendaId  String
  procesoId String
  minutos   Int    @default(0)

  prenda  LavPrenda  @relation(fields: [prendaId], references: [id], onDelete: Cascade)
  proceso LavProceso @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@unique([prendaId, procesoId])
  @@index([prendaId])
  @@index([procesoId])
  @@map("lav_duraciones")
}

// Config de turnos por día de la semana (single-tenant).
// tipo: "manana" | "tarde" | "extra". diaSemana: 0=Domingo .. 6=Sabado.
model LavTurnoConfig {
  id         String  @id @default(cuid())
  diaSemana  Int
  tipo       String
  horaInicio String // "HH:mm"
  horaFin    String // "HH:mm"
  habilitado Boolean @default(true)

  @@unique([diaSemana, tipo])
  @@map("lav_turno_config")
}

// Toggle "¿el local atiende este día?". Si atiende=false, no aplica ningún turno.
model LavDiaConfig {
  diaSemana Int     @id
  atiende   Boolean @default(false)

  @@map("lav_dia_config")
}

// Habilita el turno extra para un dia puntual (fecha en formato yyyy-MM-dd).
model LavDiaExtra {
  id         String  @id @default(cuid())
  fecha      String  @unique
  habilitado Boolean @default(true)

  @@map("lav_dia_extra")
}

model LavOT {
  id                String    @id @default(cuid())
  numero            String?
  nombreCliente     String?
  telefono          String?
  domicilio         String?
  fechaTicket       String? // texto crudo del ticket
  estado            String    @default("pendiente") // "pendiente" | "en_progreso" | "terminado"
  fechaAsignada     String // dia del tablero, yyyy-MM-dd
  orden             Int       @default(0) // posicion en la cola del dia
  duracionMin       Int       @default(0)
  aRevisar          Boolean   @default(false) // alguna prenda no se pudo mapear a la matriz
  urgente           Boolean   @default(false) // el ticket dice "URGENTE": va primero en el dia de hoy
  fechaNecesaria    String? // yyyy-MM-dd, de "PARA DD/MM": va primero el ultimo dia laborable previo
  // Division de OTs grandes: cuando una OT no entra en un turno se parte en varias
  // sub-OTs que comparten grupoId y numero. null en una OT no dividida.
  grupoId           String? // agrupa las partes de una OT dividida
  parteIndice       Int? // 1-based, para mostrar "2/6"
  parteTotal        Int? // total de partes del grupo
  empleadoCargaId   String?
  empleadoTrabajoId String?
  empezadoEn        DateTime?
  terminadoEn       DateTime?
  // Marca la entrega al cliente: una OT terminada pasa al modulo "terminados"
  // hasta que se entrega (se setea este timestamp) y sale del listado.
  entregadoEn       DateTime?
  datosIA           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empleadoCarga   LavEmpleado? @relation("LavOTCarga", fields: [empleadoCargaId], references: [id], onDelete: SetNull)
  empleadoTrabajo LavEmpleado? @relation("LavOTTrabajo", fields: [empleadoTrabajoId], references: [id], onDelete: SetNull)
  items           LavOTItem[]

  @@index([fechaAsignada])
  @@index([estado])
  @@index([grupoId])
  @@map("lav_ots")
}

model LavOTItem {
  id          String   @id @default(cuid())
  otId        String
  descripcion String
  prendaId    String?
  cantidad    Int      @default(1)
  procesoIds  String[] // ids de los procesos aplicados a la prenda (columnas de la matriz)
  duracionMin Int      @default(0)

  ot     LavOT      @relation(fields: [otId], references: [id], onDelete: Cascade)
  prenda LavPrenda? @relation(fields: [prendaId], references: [id], onDelete: SetNull)

  @@index([otId])
  @@map("lav_ot_items")
}

// Histórico enriquecido: una fila por OT (o sub-OT) que pasó por el sistema,
// pensada como ejemplo de entrenamiento para predecir "¿para cuándo estará?" al
// momento del ingreso. Es independiente de LavOT (sin FK): sobrevive a ediciones
// y borrados de la OT viva. Las features "as-of ingreso" (proyección, backlog,
// día/hora) se congelan al crear; los labels (lead time real, error de
// estimación) se completan al terminar/entregar.
model LavOTHistorico {
  id          String @id @default(cuid())
  otId        String @unique // referencia lógica a la LavOT (no FK a propósito)
  numero      String?
  grupoId     String? // agrupa partes de una OT dividida (mismo ticket)
  parteIndice Int?
  parteTotal  Int?

  // Identidad / cliente (se guarda de más, por si sirve como feature futura).
  nombreCliente String?
  telefono      String?
  domicilio     String?

  // ── Features conocidas al INGRESO (as-of creación) ──
  ingresadoEn           DateTime // = createdAt de la OT
  ingresoFecha          String // yyyy-MM-dd (AR)
  ingresoDiaSemana      Int // 0=domingo .. 6=sábado
  ingresoHoraMin        Int // minutos desde medianoche (hora AR)
  urgente               Boolean @default(false)
  fechaNecesaria        String? // yyyy-MM-dd de "PARA DD/MM"
  aRevisar              Boolean @default(false)
  duracionProyectadaMin Int // estimación del modelo al ingreso
  fechaAsignadaInicial  String? // día del tablero que prometió el modelo al ingresar
  totalPrendas          Int     @default(0) // suma de cantidades
  totalItems            Int     @default(0) // cantidad de líneas/prendas distintas
  totalProcesos         Int     @default(0) // suma de procesos aplicados
  // Carga viva del taller al ingresar (congestión que enfrentó la OT):
  backlogCount          Int? // OTs vivas por delante
  backlogMin            Int? // minutos proyectados vivos por delante

  // ── Resultado / labels ──
  empezadoEn         DateTime?
  terminadoEn        DateTime?
  entregadoEn        DateTime?
  terminadoFecha     String? // yyyy-MM-dd (AR)
  terminadoDiaSemana Int?
  esperaMin          Int? // ingreso → empezado
  ejecucionMin       Int? // empezado → terminado (wall-clock)
  leadTimeMin        Int? // ingreso → terminado  ← label principal de predicción
  leadTimeEntregaMin Int? // ingreso → entregado
  errorEstimacionMin Int? // ejecucionMin - duracionProyectadaMin (calibración del estimador)

  empleadoCargaId   String?
  empleadoTrabajoId String?

  // ── Datos crudos congelados (features futuras que hoy no anticipamos) ──
  prendas  Json // [{ prendaId, prendaNombre, descripcion, cantidad, procesoIds, procesoNombres, duracionMin }]
  datosIA  Json? // salida original de visión (ticket)
  snapshot Json? // dump completo de la OT al cerrar, por las dudas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([terminadoFecha])
  @@index([ingresoFecha])
  @@index([numero])
  @@map("lav_ot_historico")
}

// Snapshot diario del PLAN del tablero: congela, una vez por día, qué proyectaba
// el tablero para cada día del horizonte. Es efímero (el plan se pierde al
// recompactar), así que se guarda para poder comparar después "lo prometido" vs
// "lo realmente terminado ese día" (throughput real, derivable de LavOTHistorico)
// y medir el desbalance. El volumen se mide en prendas y procesos, no en cantidad
// de OTs (una OT de 21h no es comparable con una de 1h).
model LavPlanSnapshot {
  id            String   @id @default(cuid())
  snapshotEn    DateTime @default(now()) // timestamp exacto de la toma
  snapshotFecha String // yyyy-MM-dd (AR) en que se tomó el snapshot
  diaObjetivo   String // yyyy-MM-dd del horizonte que describe esta fila
  offsetDias    Int // 0 = primer día laborable (hoy), 1 = siguiente, ...
  capacidadMin  Int      @default(0)
  ocupacionMin  Int      @default(0)
  totalOts      Int      @default(0)
  totalPrendas  Int      @default(0) // suma de cantidades planificadas ese día
  totalProcesos Int      @default(0) // suma de procesos×cantidad planificados ese día
  ots           Json // [{ otId, numero, grupoId, parteIndice, estado, urgente, duracionMin, prendas, procesos }]
  createdAt     DateTime @default(now())

  @@unique([snapshotFecha, diaObjetivo])
  @@index([snapshotFecha])
  @@index([diaObjetivo])
  @@map("lav_plan_snapshots")
}

// Log append-only de todos los eventos del ciclo de vida de una OT. Es la fuente
// de verdad "guarda de más": nunca se actualiza ni borra, permite reconstruir
// cualquier métrica futura aunque la OT o el histórico cambien. Cada fila lleva
// un snapshot del contexto (backlog, día asignado) al momento del evento.
model LavOTEvento {
  id            String   @id @default(cuid())
  otId          String
  numero        String?
  grupoId       String?
  tipo          String // "creada" | "empezada" | "terminada" | "entregada" | "editada" | "movida"
  en            DateTime @default(now())
  empleadoId    String? // quién disparó la acción
  duracionMin   Int? // duración proyectada al momento del evento
  fechaAsignada String? // día del tablero al momento del evento
  orden         Int?
  backlogCount  Int? // OTs vivas por delante al momento del evento
  backlogMin    Int? // minutos proyectados vivos por delante
  payload       Json? // snapshot libre con el resto del contexto

  @@index([otId])
  @@index([tipo])
  @@index([en])
  @@map("lav_ot_eventos")
}

// Registro de consumo de la API de Claude (una fila por llamada). El costo se
// calcula y congela al insertar con la tabla de precios vigente en ese momento,
// para que el histórico quede fiel a lo facturado aunque los precios cambien.
model LavIAUso {
  id                  String   @id @default(cuid())
  creadoEn            DateTime @default(now())
  modelo              String
  contexto            String? // ej. "escaneo-comanda"
  otId                String? // OT asociada si se conoce
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheCreacionTokens Int      @default(0)
  cacheLecturaTokens  Int      @default(0)
  costoUsd            Decimal  @db.Decimal(12, 6)

  @@index([creadoEn])
  @@map("lav_ia_uso")
}
