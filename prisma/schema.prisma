// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceProvider {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  hashedPassword  String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessProfile BusinessProfile?

  @@map("service_providers")
}

model BusinessProfile {
  id                String          @id @default(cuid())
  name              String
  logoUrl           String?
  address           String?
  phone             String?
  cbu               String?
  alias             String?
  slug              String          @unique
  serviceProviderId String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  scheduleConfig    ScheduleConfig?

  @@map("business_profiles")
}

model ScheduleConfig {
  id                String          @id @default(cuid())
  startTime         String
  endTime           String
  intervalMinutes   Int
  price             Decimal
  businessProfileId String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
  appointments      Appointment[]

  @@map("schedule_configs")
}

model Appointment {
  id               String         @id @default(cuid())
  time             String
  isActive         Boolean        @default(true)
  scheduleConfigId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  scheduleConfig   ScheduleConfig @relation(fields: [scheduleConfigId], references: [id])

  @@map("appointments")
}
