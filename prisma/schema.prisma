// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceProviderRol {
  propietario
  administrador
  empleado
}

model ServiceProvider {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  hashedPassword  String
  isActive        Boolean             @default(true)
  rol             ServiceProviderRol  @default(propietario)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  businessProfile BusinessProfile?
  appointments    Appointment[]
  serviceTypes    ServiceType[]
  expenses        Expense[]
  empresas        EmpleadoEmpresa[]
  sucursales      EmpleadoSucursal[]
  scheduleConfigs ScheduleConfig[]

  @@map("service_providers")
}

model Expense {
  id                String          @id @default(cuid())
  descripcion       String
  monto             Decimal
  serviceProviderId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])

  @@map("expenses")
}

model BusinessProfile {
  id                String          @id @default(cuid())
  name              String
  logoUrl           String?
  address           String?
  phone             String?
  cbu               String?
  alias             String?
  slug              String          @unique
  rubro             String
  serviceProviderId String          @unique
  theme             String          @default("light")
  brandColor        String          @default("#1e3a5f")
  brandColorDark    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  scheduleConfigs   ScheduleConfig[]
  sucursales        Sucursal[]
  empleados         EmpleadoEmpresa[]

  @@map("business_profiles")
}

model Sucursal {
  id                String          @id @default(cuid())
  name              String
  address           String
  businessProfileId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  empleados         EmpleadoSucursal[]

  @@map("sucursales")
}

model ScheduleConfig {
  id                String           @id @default(cuid())
  name              String
  isActive          Boolean          @default(true)
  startTime         String
  endTime           String
  intervalMinutes   Int
  daysOfWeek        Int[]
  price             Decimal
  businessProfileId String
  serviceProviderId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessProfile   BusinessProfile  @relation(fields: [businessProfileId], references: [id])
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  appointments      Appointment[]
  serviceTypes      ServiceType[]

  @@map("schedule_configs")
}

model ServiceType {
  id                String           @id @default(cuid())
  title             String
  description       String?
  price             Decimal
  serviceProviderId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  serviceProvider   ServiceProvider  @relation(fields: [serviceProviderId], references: [id])
  appointments      Appointment[]
  scheduleConfigs   ScheduleConfig[]

  @@map("service_types")
}

model Appointment {
  id                String          @id @default(cuid())
  time              String
  date              String
  isActive          Boolean         @default(true)
  scheduleConfigId  String?
  serviceProviderId String
  serviceTypeId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  scheduleConfig    ScheduleConfig? @relation(fields: [scheduleConfigId], references: [id])
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  serviceType       ServiceType?    @relation(fields: [serviceTypeId], references: [id])
  booking           Booking?

  @@map("appointments")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  requires_reschedule
}

model Booking {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  clientName    String
  clientPhone   String
  status        BookingStatus  @default(pending)
  previousStatus BookingStatus?
  clienteId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  cliente       Cliente?      @relation(fields: [clienteId], references: [id])

  @@map("bookings")
}

model Cliente {
  id             String    @id @default(cuid())
  nombre         String
  apellido       String
  email          String    @unique
  hashedPassword String
  sexo           String?
  edad           Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@map("clientes")
}

model EmpleadoEmpresa {
  id                  String          @id @default(cuid())
  serviceProviderId   String
  businessProfileId   String
  createdAt           DateTime        @default(now())
  serviceProvider     ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  businessProfile     BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("empleado_empresas")
}

model EmpleadoSucursal {
  id                String          @id @default(cuid())
  serviceProviderId String
  sucursalId        String
  createdAt         DateTime        @default(now())
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  sucursal          Sucursal        @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@map("empleado_sucursales")
}
